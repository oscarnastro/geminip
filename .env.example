# Rinomina questo file in .env e inserisci i tuoi valori.
# Ottieni la chiave API su: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=la_tua_chiave_api
PORT=3000
# Modello Gemini da usare (opzionale, default: gemini-1.5-flash)
# Esempi: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
