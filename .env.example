# Rinomina questo file in .env e inserisci i tuoi valori.
# Ottieni la chiave API su: https://platform.deepseek.com/

DEEPSEEK_API_KEY=la_tua_chiave_api
PORT=3000
# Modello DeepSeek da usare (opzionale, default: deepseek-chat)
# Se non disponibile, il server prova automaticamente: deepseek-reasoner
# Allegati supportati per estrazione testo lato server: .docx, .pdf, .txt, .csv
DEEPSEEK_MODEL=deepseek-chat
# Numero massimo di retry per modello in caso di errore temporaneo (opzionale, default: 2)
DEEPSEEK_MAX_RETRIES_PER_MODEL=2
# Ritardo iniziale tra i retry in millisecondi (opzionale, default: 1000)
DEEPSEEK_INITIAL_RETRY_DELAY_MS=1000
# Timeout per ogni singola richiesta a DeepSeek in millisecondi (opzionale, default: 25000)
# Se DeepSeek non risponde entro questo tempo, la richiesta viene annullata e ritentata.
# Aumenta questo valore se ricevi errori di timeout per domande complesse.
DEEPSEEK_REQUEST_TIMEOUT_MS=25000

# Basic Auth — REQUIRED. The app will not start if either variable is missing.
BASIC_AUTH_USER=your_username
BASIC_AUTH_PASSWORD=your_strong_password

# Rate limiting (optional — defaults shown below)
# Time window in milliseconds for counting requests (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum number of requests per IP per window for all routes (default: 200)
RATE_LIMIT_MAX=200
# Maximum number of POST /api/chat requests per IP per window (default: 10)
CHAT_RATE_LIMIT_MAX=10
