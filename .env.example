# Rinomina questo file in .env e inserisci i tuoi valori.
# Ottieni la chiave API su: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=la_tua_chiave_api
PORT=3000
# Modello Gemini da usare (opzionale, default: gemini-2.5-flash)
# Se non disponibile, il server prova automaticamente: gemini-2.0-flash, gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.5-flash
